{
  "$schema": "https://unpkg.com/release-it/schema/release-it.json",

  "github": {
    "release": true,
    "releaseName" : "cmc-helper@v${version}",
    "assets": [".output/*.zip"],
    "releaseNotes": ""
  },

  "hooks": {
    "before:release": "rm -f .output/*.zip && npm run zip && echo Releasing version ${version}"
  },

  "npm": {
    "publish": false
  },

  "git": {
    "tagName": "v${version}",
    "requireCleanWorkingDir": false
  }
}
